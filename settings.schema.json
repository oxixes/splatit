{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://json-schema.org/draft-07/schema#",
  "title": "SplatIt settings file",
  "description": "A settings file for the SplatIt Splatoon server",
  "type": "object",
  "properties": {
    "domain": {
        "description": "The domain name of the server",
        "type": "string"
    },
    "ssl": {
      "description": "SSL settings",
      "type": "object",
      "properties": {
        "caCert": {
          "description": "The path to the CA certificate",
          "type": "string"
        },
        "cert": {
          "description": "The path to the server certificate",
          "type": "string"
        },
        "caKey": {
          "description": "The path to the CA key",
          "type": "string"
        },
        "key": {
          "description": "The path to the server key",
          "type": "string"
        }
      },
      "required": ["caCert", "cert", "key"]
    },
    "http": {
      "description": "HTTP settings (apply to the account and BOSS servers)",
      "listenAddress": {
        "description": "IP address to listen to",
        "type": "string",
        "pattern": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}$"
      },
      "listenPort": {
        "description": "Port to listen to",
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "workerCount": {
        "description": "Number of worker threads to use",
        "type": "integer",
        "minimum": 1
      },
      "keepAliveTimeout": {
        "description": "Timeout for keep-alive connections (in seconds)",
        "type": "integer",
        "minimum": 1
      },
      "ssl": {
        "description": "Enable SSL",
        "type": "boolean"
      },
      "required": ["listenAddress", "workerCount", "keepAliveTimeout", "ssl"]
    },
    "nex": {
      "description": "NEX settings",
      "tokenKey": {
        "description": "The key to use for signing access tokens (32 bytes base64 encoded)",
        "type": "string"
      },
      "knownProxies": {
        "description": "List of known proxies",
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3})$"
        }
      },
      "serverId": {
        "description": "The server ID to use in NEX servers",
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      },
      "required": ["tokenKey", "serverId"]
    },
    "grpc": {
      "description": "gRPC settings",
      "properties": {
        "enabled": {
          "description": "Enable or disable gRPC server",
          "type": "boolean"
        },
        "listenAddress": {
          "description": "IP address to listen to",
          "type": "string",
          "pattern": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}$"
        },
        "port": {
          "description": "Port to listen to",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "reflection": {
          "description": "Enable or disable gRPC reflection",
          "type": "boolean",
          "default": false
        },
        "publicFacingAddress": {
          "description": "Public facing address for other servers to connect to",
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "enabled": { "const": true }
        }
      },
      "then": {
        "required": ["listenAddress", "port", "publicFacingAddress"]
      },
      "required": ["enabled"]
    },
    "friendsAuth": {
      "description": "Settings for the friends authentication server",
      "properties": {
        "enabled": {
          "description": "Enable or disable the friends authentication server",
          "type": "boolean"
        },
        "listenAddress": {
          "description": "IP address to listen to",
          "type": "string",
          "pattern": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}$"
        },
        "port": {
          "description": "Port to listen to",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "workerCount": {
          "description": "Number of worker threads to use",
          "type": "integer",
          "minimum": 1
        },
        "secure": {
          "description": "Information about the secure server",
          "type": "object",
          "properties": {
            "address": {
              "description": "IP address to listen to",
              "type": "string",
              "pattern": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}$"
            },
            "port": {
              "description": "Port to listen to",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": ["address", "port"]
        },
        "db": {
          "description": "Database settings",
          "type": "object",
          "properties": {
            "type": {
              "description": "The database type to use",
              "type": "string",
              "enum": ["SQLite3"]
            },
            "path": {
              "description": "Path to the database file",
              "type": "string"
            },
            "host": {
              "description": "Host of the database",
              "type": "string"
            },
            "port": {
              "description": "Port of the database",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "user": {
              "description": "User name of the database",
              "type": "string"
            },
            "password": {
              "description": "Password of the user in the database",
              "type": "string"
            },
            "name": {
              "description": "Name of the database to connect to",
              "type": "string"
            }
          },
          "required": ["type"],
          "if": {
            "properties": {
              "type": {"const": "SQLite3"}
            },
            "required": ["type"]
          },
          "then": {
            "required": ["path"]
          },
          "else": {
            "required": ["host", "port", "user", "password", "name"]
          }
        }
      },
      "if": {
        "properties": {
          "enabled": { "const": true }
        }
      },
      "then": {
        "required": ["listenAddress", "port", "workerCount", "secure", "db"]
      },
      "required": ["enabled"]
    },
    "splatoonAuth": {
      "description": "Settings for the Splatoon authentication server",
      "properties": {
        "enabled": {
          "description": "Enable or disable the friends authentication server",
          "type": "boolean"
        },
        "listenAddress": {
          "description": "IP address to listen to",
          "type": "string",
          "pattern": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}$"
        },
        "port": {
          "description": "Port to listen to",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "workerCount": {
          "description": "Number of worker threads to use",
          "type": "integer",
          "minimum": 1
        },
        "secure": {
          "description": "Information about the secure server",
          "type": "object",
          "properties": {
            "address": {
              "description": "IP address to listen to",
              "type": "string",
              "pattern": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}$"
            },
            "port": {
              "description": "Port to listen to",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": ["address", "port"]
        },
        "db": {
          "description": "Database settings",
          "type": "object",
          "properties": {
            "type": {
              "description": "The database type to use",
              "type": "string",
              "enum": ["SQLite3"]
            },
            "path": {
              "description": "Path to the database file",
              "type": "string"
            },
            "host": {
              "description": "Host of the database",
              "type": "string"
            },
            "port": {
              "description": "Port of the database",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "user": {
              "description": "User name of the database",
              "type": "string"
            },
            "password": {
              "description": "Password of the user in the database",
              "type": "string"
            },
            "name": {
              "description": "Name of the database to connect to",
              "type": "string"
            }
          },
          "required": ["type"],
          "if": {
            "properties": {
              "type": {"const": "SQLite3"}
            },
            "required": ["type"]
          },
          "then": {
            "required": ["path"]
          },
          "else": {
            "required": ["host", "port", "user", "password", "name"]
          }
        }
      },
      "if": {
        "properties": {
          "enabled": { "const": true }
        }
      },
      "then": {
        "required": ["listenAddress", "port", "workerCount", "secure", "db"]
      },
      "required": ["enabled"]
    },
    "friendsSecure": {
      "description": "Settings for the friends secure server",
      "properties": {
        "enabled": {
          "description": "Enable or disable the friends secure server",
          "type": "boolean"
        },
        "listenAddress": {
          "description": "IP address to listen to",
          "type": "string",
          "pattern": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}$"
        },
        "port": {
          "description": "Port to listen to",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "workerCount": {
          "description": "Number of worker threads to use",
          "type": "integer",
          "minimum": 1
        },
        "grpcRequestTimeout": {
          "description": "Timeout for gRPC requests (in milliseconds)",
          "type": "integer",
          "minimum": 1
        },
        "grpcConnectionPoolMaxSize": {
          "description": "Maximum size of the gRPC connection pool",
          "type": "integer",
          "minimum": 1
        },
        "db": {
          "description": "Database settings",
          "type": "object",
          "properties": {
            "type": {
              "description": "The database type to use",
              "type": "string",
              "enum": ["SQLite3"]
            },
            "path": {
              "description": "Path to the database file",
              "type": "string"
            },
            "host": {
              "description": "Host of the database",
              "type": "string"
            },
            "port": {
              "description": "Port of the database",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "user": {
              "description": "User name of the database",
              "type": "string"
            },
            "password": {
              "description": "Password of the user in the database",
              "type": "string"
            },
            "name": {
              "description": "Name of the database to connect to",
              "type": "string"
            }
          },
          "required": ["type"],
          "if": {
            "properties": {
              "type": {"const": "SQLite3"}
            },
            "required": ["type"]
          },
          "then": {
            "required": ["path"]
          },
          "else": {
            "required": ["host", "port", "user", "password", "name"]
          }
        }
      },
      "if": {
        "properties": {
          "enabled": { "const": true }
        }
      },
      "then": {
        "required": ["listenAddress", "port", "workerCount", "grpcRequestTimeout", "grpcConnectionPoolMaxSize", "db"]
      },
      "required": ["enabled"]
    },
    "splatoonSecure": {
      "description": "Settings for the Splatoon secure server",
      "properties": {
        "enabled": {
          "description": "Enable or disable the friends secure server",
          "type": "boolean"
        },
        "listenAddress": {
          "description": "IP address to listen to",
          "type": "string",
          "pattern": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}$"
        },
        "port": {
          "description": "Port to listen to",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "workerCount": {
          "description": "Number of worker threads to use",
          "type": "integer",
          "minimum": 1
        }
      },
      "if": {
        "properties": {
          "enabled": { "const": true }
        }
      },
      "then": {
        "required": ["listenAddress", "port", "workerCount"]
      },
      "required": ["enabled"]
    },
    "accounts": {
      "description": "Configuration of the accounts server",
      "properties": {
        "enabled": {
          "description": "Enable or disable the account server",
          "type": "boolean"
        },
        "tokenKey": {
          "description": "The key to use for signing tokens (32 bytes base64 encoded)",
          "type": "string"
        },
        "refreshTokenKey": {
          "description": "The key to use for signing refresh tokens (32 bytes base64 encoded)",
          "type": "string"
        },
        "deviceKeyPath": {
          "description": "The path to the key used to generate device certificates",
          "type": "string"
        },
        "miiImagesPath": {
          "description": "The path to the Mii images",
          "type": "string"
        },
        "hosts": {
          "description": "Mapping of server ids to hosts",
          "type": "object",
          "patternProperties": {
            "^[A-F0-9]{8}$": {
              "description": "Host information for a specific server ID",
              "type": "array",
              "items": {
                "type": "object",
                "description": "Host information",
                "properties": {
                  "address": {
                    "description": "IP address and port of the server",
                    "type": "string",
                    "pattern": "^([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}:[0-9]{1,4})(:[0-9]{1,4})?$"
                  },
                  "grpcAddress": {
                    "description": "IP address and port of the gRPC server",
                    "type": "string",
                    "pattern": "^([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}:[0-9]{1,4})(:[0-9]{1,4})?$"
                  }
                }
              },
              "minItems": 1
            }
          }
        },
        "secureServerGrpcAddresses": {
          "description": "Mapping of server ids to secure server gRPC addresses",
          "type": "object",
          "patternProperties": {
            "^[A-F0-9]{8}$": {
              "description": "gRPC addresses for a specific server ID",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}:[0-9]{1,4})(:[0-9]{1,4})?$"
              },
              "minItems": 1
            }
          }
        },
        "allowRealWiiU": {
            "description": "Allow real Wii U consoles to connect",
            "type": "boolean"
        },
        "allowGeneratedWiiU": {
            "description": "Allow generated Wii U consoles (fake files) to connect",
            "type": "boolean"
        },
        "db": {
          "description": "Database settings",
          "type": "object",
          "properties": {
            "type": {
              "description": "The database type to use",
              "type": "string",
              "enum": ["SQLite3"]
            },
            "path": {
              "description": "Path to the database file",
              "type": "string"
            },
            "host": {
              "description": "Host of the database",
              "type": "string"
            },
            "port": {
              "description": "Port of the database",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "user": {
              "description": "User name of the database",
              "type": "string"
            },
            "password": {
              "description": "Password of the user in the database",
              "type": "string"
            },
            "name": {
              "description": "Name of the database to connect to",
              "type": "string"
            }
          },
          "required": ["type"],
          "if": {
            "properties": {
              "type": {"const": "SQLite3"}
            },
            "required": ["type"]
          },
          "then": {
            "required": ["path"]
          },
          "else": {
            "required": ["host", "port", "user", "password", "name"]
          }
        },
        "email": {
          "description": "Email settings for account verification and password reset",
          "type": "object",
          "properties": {
            "enabled": {
              "description": "Enable or disable email functionality. If disabled, all emails will be automatically marked as verified.",
              "type": "boolean"
            },
            "host": {
              "description": "SMTP server host",
              "type": "string"
            },
            "port": {
              "description": "SMTP server port",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "authMethod": {
              "description": "Authentication method for the SMTP server",
              "type": "string",
              "enum": ["none", "login", "starttls"]
            },
            "username": {
              "description": "Username for SMTP authentication",
              "type": "string"
            },
            "password": {
              "description": "Password for SMTP authentication",
              "type": "string"
            },
            "sender": {
              "description": "Email address to use as the sender",
              "type": "string"
            },
            "sendTimeout": {
              "description": "Timeout for sending emails (in milliseconds)",
              "type": "integer",
              "minimum": 1
            }
          },
          "if": {
            "properties": {
              "enabled": { "const": true }
            }
          },
          "then": {
            "required": ["host", "port", "authMethod", "username", "password", "sender", "sendTimeout"]
          },
          "required": ["enabled"]
        },
        "grpcRequestTimeout": {
          "description": "Timeout for gRPC requests (in milliseconds)",
          "type": "integer",
          "minimum": 1
        },
        "grpcConnectionPoolMaxSize": {
          "description": "Maximum size of the gRPC connection pool",
          "type": "integer",
          "minimum": 1
        }
      },
      "if": {
        "properties": {
          "enabled": { "const": true }
        }
      },
      "then": {
        "required": ["tokenKey", "refreshTokenKey", "deviceKeyPath", "miiImagesPath", "allowRealWiiU", "allowGeneratedWiiU", "hosts", "secureServerGrpcAddresses" ,"db", "grpcRequestTimeout", "grpcConnectionPoolMaxSize", "email"]
      },
      "required": ["enabled"]
    },
    "boss": {
      "description": "Configuration of the BOSS server",
      "properties": {
        "enabled": {
          "description": "Enable or disable the BOSS server",
          "type": "boolean"
        },
        "path": {
          "description": "Path to the BOSS server files",
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "enabled": { "const": true }
        }
      },
      "then": {
        "required": ["path"]
      },
      "required": ["enabled"]
    },
    "management": {
      "description": "Management server settings",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Enable or disable the management server",
          "type": "boolean"
        },
        "listenAddress": {
          "description": "IP address to listen to",
          "type": "string",
          "pattern": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}$"
        },
        "listenPort": {
          "description": "Port to listen to",
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "workerCount": {
          "description": "Number of worker threads to use",
          "type": "integer",
          "minimum": 1
        },
        "keepAliveTimeout": {
          "description": "Timeout for keep-alive connections (in seconds)",
          "type": "integer",
          "minimum": 1
        },
        "grpcRequestTimeout": {
          "description": "Timeout for gRPC requests (in milliseconds)",
          "type": "integer",
          "minimum": 1
        },
        "grpcConnectionPoolMaxSize": {
          "description": "Maximum size of the gRPC connection pool",
          "type": "integer",
          "minimum": 1
        },
        "corsOrigin": {
          "description": "Allowed CORS origin",
          "type": "string"
        },
        "servers": {
          "description": "Mapping of server names to their gRPC addresses",
          "type": "object",
          "properties": {
            "accounts": {
              "description": "gRPC addresses of the accounts server",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}:[0-9]{1,4})(:[0-9]{1,4})?$"
              }
            },
            "boss": {
              "description": "gRPC addresses of the BOSS server",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}:[0-9]{1,4})(:[0-9]{1,4})?$"
              }
            },
            "friendsAuth": {
              "description": "gRPC addresses of the friends authentication server",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}:[0-9]{1,4})(:[0-9]{1,4})?$"
              }
            },
            "splatoonAuth": {
              "description": "gRPC addresses of the Splatoon authentication server",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}:[0-9]{1,4})(:[0-9]{1,4})?$"
              }
            },
            "friendsSecure": {
              "description": "gRPC addresses of the friends secure server",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}:[0-9]{1,4})(:[0-9]{1,4})?$"
              }
            },
            "splatoonSecure": {
              "description": "gRPC addresses of the Splatoon secure server",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}:[0-9]{1,4})(:[0-9]{1,4})?$"
              }
            }
          },
          "required": ["accounts", "boss", "friendsAuth", "splatoonAuth", "friendsSecure", "splatoonSecure"]
        }
      },
      "if": {
        "properties": {
          "enabled": { "const": true }
        }
      },
      "then": {
        "required": ["listenAddress", "listenPort", "workerCount", "keepAliveTimeout", "grpcRequestTimeout", "grpcConnectionPoolMaxSize", "corsOrigin", "servers"]
      },
      "required": ["enabled"]
    },
    "sharedState": {
      "description": "Shared state configuration for distributed server instances",
      "type": "object",
      "properties": {
        "type": {
          "description": "The type of shared state to use",
          "type": "string",
          "enum": ["local", "redis"]
        },
        "redis": {
          "description": "Redis configuration (required if type is 'redis')",
          "type": "object",
          "properties": {
            "host": {
              "description": "Redis server hostname or IP address",
              "type": "string"
            },
            "port": {
              "description": "Redis server port",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "password": {
              "description": "Redis password (leave empty for no authentication)",
              "type": "string"
            },
            "database": {
              "description": "Redis database number",
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "connectionTimeoutMs": {
              "description": "Maximum time to wait for connection establishment (milliseconds)",
              "type": "integer",
              "minimum": 100
            },
            "commandTimeoutMs": {
              "description": "Maximum time to wait for Redis commands (milliseconds)",
              "type": "integer",
              "minimum": 100
            },
            "useSSL": {
              "description": "Enable SSL/TLS encryption",
              "type": "boolean"
            },
            "caCertPath": {
              "description": "Path to CA certificate file (for SSL)",
              "type": "string"
            },
            "certPath": {
              "description": "Path to client certificate file (for SSL)",
              "type": "string"
            },
            "keyPath": {
              "description": "Path to client key file (for SSL)",
              "type": "string"
            },
